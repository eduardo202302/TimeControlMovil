{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "types": ["jest", "node"]
  },
  "include": ["src/utils/**/*.ts", "types/**/*.ts"]
}
