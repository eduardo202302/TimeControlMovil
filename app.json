{
  "expo": {
    "name": "timeControlApp",
    "slug": "timeControlMovil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/logo2.png",
    "scheme": "timecontrolapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere acceso a tu ubicación para validar que el ponche se realice dentro del área permitida de la institución."
      }
    },
    "android": {
      "package": "com.timecontrol.movil",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "icon": "./assets/images/logos/logo_adaptive.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logos/logo_adaptive.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFEFEF",
          "android": {
            "image": "./assets/images/logos/logo_adaptive.png",
            "imageWidth": 100
          }
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta aplicación requiere acceso a tu ubicación para validar que el ponche se realice dentro del área permitida de la institución."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea57f376-647a-4164-a977-94d685b3ac4e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b8ca7a8a-5e7f-4651-bc4d-86fb78e6c908"
    },
    "owner": "anthonyjr0511"
  }
}
